PROJECT_NAME="EVE Healthcare Diagnostic & Payment Service"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL default, falls back to SQLite for local development)
DATABASE_URL="sqlite:///./eve_healthcare.db"
# For Docker / Production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eve_healthcare"

# Security / JWT
SECRET_KEY="super-secret-development-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Webhook Security
WEBHOOK_SECRET_KEY="simulated-payment-gateway-secret"
